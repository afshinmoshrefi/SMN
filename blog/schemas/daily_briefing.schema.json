{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "edition_date",
    "timezone",
    "cutoff",
    "label",
    "title",
    "scan",
    "sources",
    "groups",
    "claims",
    "narrative",
    "script",
    "storyboard"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "edition_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": {
      "type": "string",
      "const": "America/New_York"
    },
    "cutoff": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "enum": [
        "Before the Open",
        "Intraday",
        "Market Wrap"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "publisher",
          "status",
          "note"
        ],
        "properties": {
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "accessed",
              "partial",
              "unavailable",
              "not_attempted"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "publisher",
          "origin_id",
          "published_at",
          "retrieved_at",
          "access"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "origin_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "type": "string",
            "enum": [
              "full_text",
              "primary_release",
              "snippet",
              "metadata",
              "unavailable"
            ]
          },
          "capture": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "text_sha256",
              "scope"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "text_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "observation_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "complete_document",
                  "selected_passages_from_accessed_document"
                ]
              }
            }
          },
          "published_at_raw": {
            "type": "string",
            "minLength": 1
          },
          "timestamp_status": {
            "type": "string",
            "enum": [
              "verified",
              "uncertain"
            ]
          },
          "cutoff_basis": {
            "type": "string",
            "enum": ["publication_metadata", "observed_capture"]
          }
        }
      },
      "minItems": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event_key",
          "headline",
          "selected",
          "reason",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "event_key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "headline": {
            "type": "string",
            "minLength": 1
          },
          "selected": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
            },
            "uniqueItems": true
          }
        }
      },
      "minItems": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "group_id",
          "text",
          "kind",
          "event_at",
          "event_status",
          "supports"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "group_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "interpretation",
              "synthesis"
            ]
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "event_at": {
            "type": "string",
            "minLength": 1
          },
          "event_status": {
            "type": "string",
            "enum": [
              "reported",
              "background",
              "upcoming"
            ]
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "locator",
                "quote"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    },
    "narrative": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "claim_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      },
      "minItems": 1
    },
    "script": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "claim_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      },
      "minItems": 1
    },
    "storyboard": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "claim_ids",
          "visual_kind"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "visual_kind": {
            "type": "string",
            "enum": [
              "headline_card",
              "source_visual",
              "presenter"
            ]
          },
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          }
        }
      },
      "minItems": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seasonalmarketnews.com/schemas/daily_briefing.schema.json",
  "title": "Offline daily briefing revision"
}
